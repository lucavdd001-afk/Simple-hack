--// Mobile Script Hub with Key System
--// Key: lucabom101

local correctKey = "lucabom101"

-- SERVICES
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- VARIABLES
local flying = false
local noclip = false
local infJump = false
local speedEnabled = false

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

-- KEY FRAME
local KeyFrame = Instance.new("Frame")
KeyFrame.Size = UDim2.new(0, 300, 0, 180)
KeyFrame.Position = UDim2.new(0.5, -150, 0.5, -90)
KeyFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
KeyFrame.Parent = ScreenGui

local KeyTitle = Instance.new("TextLabel")
KeyTitle.Size = UDim2.new(1,0,0,40)
KeyTitle.Text = "Enter Key"
KeyTitle.TextColor3 = Color3.new(1,1,1)
KeyTitle.BackgroundTransparency = 1
KeyTitle.TextScaled = true
KeyTitle.Parent = KeyFrame

local KeyBox = Instance.new("TextBox")
KeyBox.Size = UDim2.new(0.8,0,0,40)
KeyBox.Position = UDim2.new(0.1,0,0.35,0)
KeyBox.PlaceholderText = "Key Here"
KeyBox.Text = ""
KeyBox.TextScaled = true
KeyBox.Parent = KeyFrame

local Submit = Instance.new("TextButton")
Submit.Size = UDim2.new(0.6,0,0,40)
Submit.Position = UDim2.new(0.2,0,0.7,0)
Submit.Text = "Submit"
Submit.TextScaled = true
Submit.BackgroundColor3 = Color3.fromRGB(50,50,50)
Submit.TextColor3 = Color3.new(1,1,1)
Submit.Parent = KeyFrame

-- MAIN HUB
local HubFrame = Instance.new("Frame")
HubFrame.Size = UDim2.new(0, 320, 0, 300)
HubFrame.Position = UDim2.new(0.5, -160, 0.5, -150)
HubFrame.BackgroundColor3 = Color3.fromRGB(30,30,30)
HubFrame.Visible = false
HubFrame.Parent = ScreenGui

local HubTitle = Instance.new("TextLabel")
HubTitle.Size = UDim2.new(1,0,0,40)
HubTitle.Text = "Mobile Script Hub"
HubTitle.TextScaled = true
HubTitle.TextColor3 = Color3.new(1,1,1)
HubTitle.BackgroundTransparency = 1
HubTitle.Parent = HubFrame

-- BUTTON CREATOR
local function createButton(text, posY)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.8,0,0,40)
	btn.Position = UDim2.new(0.1,0,0,posY)
	btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
	btn.TextColor3 = Color3.new(1,1,1)
	btn.TextScaled = true
	btn.Text = text
	btn.Parent = HubFrame
	return btn
end

local SpeedBtn = createButton("Speed: OFF", 50)
local JumpBtn = createButton("Infinite Jump: OFF", 100)
local NoclipBtn = createButton("Noclip: OFF", 150)
local FlyBtn = createButton("Fly: OFF", 200)

-- KEY CHECK
Submit.MouseButton1Click:Connect(function()
	if KeyBox.Text == correctKey then
		KeyFrame.Visible = false
		HubFrame.Visible = true
	else
		KeyBox.Text = ""
		KeyBox.PlaceholderText = "Wrong Key!"
	end
end)

-- SPEED
SpeedBtn.MouseButton1Click:Connect(function()
	speedEnabled = not speedEnabled
	
	if speedEnabled then
		Humanoid.WalkSpeed = 50
		SpeedBtn.Text = "Speed: ON"
	else
		Humanoid.WalkSpeed = 16
		SpeedBtn.Text = "Speed: OFF"
	end
end)

-- INFINITE JUMP
JumpBtn.MouseButton1Click:Connect(function()
	infJump = not infJump
	
	if infJump then
		JumpBtn.Text = "Infinite Jump: ON"
	else
		JumpBtn.Text = "Infinite Jump: OFF"
	end
end)

UIS.JumpRequest:Connect(function()
	if infJump then
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- NOCLIP
NoclipBtn.MouseButton1Click:Connect(function()
	noclip = not noclip
	
	if noclip then
		NoclipBtn.Text = "Noclip: ON"
	else
		NoclipBtn.Text = "Noclip: OFF"
	end
end)

game:GetService("RunService").Stepped:Connect(function()
	if noclip and Character then
		for _, v in pairs(Character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = false
			end
		end
	end
end)

-- FLY
local BodyVelocity
local BodyGyro

FlyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	
	local root = Character:WaitForChild("HumanoidRootPart")
	
	if flying then
		FlyBtn.Text = "Fly: ON"
		
		BodyVelocity = Instance.new("BodyVelocity")
		BodyVelocity.MaxForce = Vector3.new(999999,999999,999999)
		BodyVelocity.Velocity = Vector3.new(0,0,0)
		BodyVelocity.Parent = root
		
		BodyGyro = Instance.new("BodyGyro")
		BodyGyro.MaxTorque = Vector3.new(999999,999999,999999)
		BodyGyro.CFrame = root.CFrame
		BodyGyro.Parent = root
		
		Humanoid.PlatformStand = true
		
		while flying do
			task.wait()
			BodyVelocity.Velocity = workspace.CurrentCamera.CFrame.LookVector * 50
			BodyGyro.CFrame = workspace.CurrentCamera.CFrame
		end
	else
		FlyBtn.Text = "Fly: OFF"
		
		Humanoid.PlatformStand = false
		
		if BodyVelocity then
			BodyVelocity:Destroy()
		end
		
		if BodyGyro then
			BodyGyro:Destroy()
		end
	end
end)
