-- Mobile Script Hub with Key System and Toggles
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Key system code
local correctCode = "lucabom101"
local enteredCode = ""

-- Features state
local speedEnabled = false
local infJumpEnabled = false
local noclipEnabled = false
local flyEnabled = false

-- Speed changer value
local baseSpeed = 16
local speedMultiplier = 3

-- UI for mobile input
local ScreenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
ScreenGui.Name = "ScriptHubGui"

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0.7, 0, 0.5, 0)
Frame.Position = UDim2.new(0.15, 0, 0.25, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Visible = true

local TextLabel = Instance.new("TextLabel", Frame)
TextLabel.Size = UDim2.new(1, 0, 0.2, 0)
TextLabel.Position = UDim2.new(0, 0, 0, 0)
TextLabel.Text = "Enter Key Code:"
TextLabel.TextColor3 = Color3.new(1, 1, 1)
TextLabel.BackgroundTransparency = 1
TextLabel.TextScaled = true

local TextBox = Instance.new("TextBox", Frame)
TextBox.Size = UDim2.new(1, -10, 0.2, 0)
TextBox.Position = UDim2.new(0, 5, 0.25, 0)
TextBox.ClearTextOnFocus = true
TextBox.Text = ""
TextBox.PlaceholderText = "Enter code here"
TextBox.TextScaled = true

local Button = Instance.new("TextButton", Frame)
Button.Size = UDim2.new(1, -10, 0.2, 0)
Button.Position = UDim2.new(0, 5, 0.5, 0)
Button.Text = "Submit Code"
Button.TextScaled = true
Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Button.TextColor3 = Color3.new(1, 1, 1)

local InfoLabel = Instance.new("TextLabel", Frame)
InfoLabel.Size = UDim2.new(1, 0, 0.3, 0)
InfoLabel.Position = UDim2.new(0, 0, 0.75, 0)
InfoLabel.Text = ""
InfoLabel.TextColor3 = Color3.new(1, 0, 0)
InfoLabel.BackgroundTransparency = 1
InfoLabel.TextScaled = true
InfoLabel.TextWrapped = true

-- Features buttons container (hidden until correct code)
local FeaturesFrame = Instance.new("Frame", ScreenGui)
FeaturesFrame.Size = UDim2.new(0.7, 0, 0.5, 0)
FeaturesFrame.Position = UDim2.new(0.15, 0, 0.25, 0)
FeaturesFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
FeaturesFrame.Visible = false

local function createToggleButton(name, position)
    local btn = Instance.new("TextButton", FeaturesFrame)
    btn.Size = UDim2.new(1, -20, 0.15, 0)
    btn.Position = UDim2.new(0, 10, 0, position)
    btn.Text = name .. ": OFF"
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    btn.TextColor3 = Color3.new(1, 1, 1)
    return btn
end

local speedBtn = createToggleButton("Speed Changer", 10)
local infJumpBtn = createToggleButton("Infinite Jump", 80)
local noclipBtn = createToggleButton("Noclip", 150)
local flyBtn = createToggleButton("Fly", 220)

-- Functions to toggle features
local function toggleSpeed()
    speedEnabled = not speedEnabled
    if speedEnabled then
        humanoid.WalkSpeed = baseSpeed * speedMultiplier
        speedBtn.Text = "Speed Changer: ON"
    else
        humanoid.WalkSpeed = baseSpeed
        speedBtn.Text = "Speed Changer: OFF"
    end
end

local function toggleInfJump()
    infJumpEnabled = not infJumpEnabled
    infJumpBtn.Text = "Infinite Jump: " .. (infJumpEnabled and "ON" or "OFF")
end

local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    noclipBtn.Text = "Noclip: " .. (noclipEnabled and "ON" or "OFF")
end

local flyVelocity = Instance.new("BodyVelocity")
flyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
flyVelocity.Velocity = Vector3.new(0, 0, 0)

local function toggleFly()
    flyEnabled = not flyEnabled
    flyBtn.Text = "Fly: " .. (flyEnabled and "ON" or "OFF")
    if flyEnabled then
        flyVelocity.Parent = rootPart
    else
        flyVelocity.Parent = nil
    end
end

-- Connect buttons to functions
speedBtn.MouseButton1Click:Connect(toggleSpeed)
infJumpBtn.MouseButton1Click:Connect(toggleInfJump)
noclipBtn.MouseButton1Click:Connect(toggleNoclip)
flyBtn.MouseButton1Click:Connect(toggleFly)

-- Key system check
Button.MouseButton1Click:Connect(function()
    if TextBox.Text == correctCode then
        InfoLabel.TextColor3 = Color3.new(0, 1, 0)
        InfoLabel.Text = "Access Granted!"
        Frame.Visible = false
        FeaturesFrame.Visible = true
    else
        InfoLabel.TextColor3 = Color3.new(1, 0, 0)
        InfoLabel.Text = "Incorrect code. Try again!"
    end
end)

-- Infinite jump handling
UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Noclip handling
RunService.Stepped:Connect(function()
    if noclipEnabled then
        for _, part in pairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    else
        for _, part in pairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end)

-- Fly handling (simple upward/downward with jump/crouch)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if flyEnabled and not gameProcessed then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.Keyboard then
            -- Basic fly control: Ascend with jump, descend with left control/crouch (if available)
            if input.KeyCode == Enum.KeyCode.Space then
                flyVelocity.Velocity = Vector3.new(0, 50, 0)
            elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then
                flyVelocity.Velocity = Vector3.new(0, -50, 0)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if flyEnabled then
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then
            flyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Reset speed if character respawns
player.CharacterAdded:Connect(function(char)
    character = char
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid.WalkSpeed = baseSpeed
end)
